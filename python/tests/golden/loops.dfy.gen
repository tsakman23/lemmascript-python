// Generated by lsc from loops.py

function FloorDiv(a: int, b: int): int
  requires b != 0
{
  if b < 0 && a % b != 0 then a / b - 1 else a / b
}

function FloorMod(a: int, b: int): int
  requires b != 0
  ensures b > 0 ==> 0 <= FloorMod(a, b) < b
  ensures b < 0 ==> b < FloorMod(a, b) <= 0
  ensures a == b * FloorDiv(a, b) + FloorMod(a, b)
{
  if b < 0 && a % b != 0 then a % b + b else a % b
}

method count_down(n: int) returns (res: int)
  requires (n >= 0)
  ensures (res == 0)
{
  var n := n;
  while (n > 0)
    invariant (n >= 0)
    decreases n
  {
    n := (n - 1);
  }
  return n;
}

method first_zero(xs: seq<int>) returns (res: int)
  ensures (-1 <= res)
  ensures (res < |xs|)
  ensures ((res >= 0) ==> (xs[res] == 0))
{
  var r := -1;
  ghost var steps: int := 0;
  var i_stop := |xs|;
  var i := 0;
  while (i < i_stop)
    invariant (0 <= i)
    invariant ((i <= i_stop) || (i == 0))
    invariant (r == -1)
  {
    assert ((0 <= i) && (i < |xs|));
    if (xs[i] == 0) {
      r := i;
      break;
    }
    steps := (steps + 1);
    i := (i + 1);
  }
  return r;
}

method odd_positions(xs: seq<int>) returns (res: int)
{
  var s := 0;
  var i := 0;
  while (i < |xs|)
    invariant (0 <= i)
    invariant (i <= |xs|)
  {
    var x := xs[i];
    if (FloorMod(i, 2) == 0) {
      i := (i + 1);
    } else {
      s := (s + x);
      i := (i + 1);
    }
  }
  var i_y_idx := 0;
  while i_y_idx < |xs|
    invariant (i_y_idx <= |xs|)
  {
    var y := xs[i_y_idx];
    s := (s + (0 * y));
    i_y_idx := i_y_idx + 1;
  }
  return s;
}
