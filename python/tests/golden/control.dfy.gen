// Generated by lsc from control.py

function MathAbs(x: int): nat { if x >= 0 then x else -x }

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

function helper(x: int): int
  requires (x >= 0)
{
  (x + 1)
}

lemma helper_ensures(x: int)
  requires (x >= 0)
  ensures (helper(x) >= x)
{
}

method steps(n: int) returns (res: int)
  requires (0 <= n)
  requires (n <= 100)
{
  var n := n;
  if !((n >= 0)) {
    assert false;
  }
  if (n > 100) {
    assert false;
  }
  var total := 0;
  total := helper(n);
  n := (n + 1);
  if (total > n) {
    assert false;
  }
  return ((MathAbs(total) + MathMin(MathMin(n, total), 3)) + MathMax(n, 1));
}
