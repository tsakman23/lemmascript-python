// Generated by lsc from floor_ops.py

function FloorDiv(a: int, b: int): int
  requires b != 0
{
  if b < 0 && a % b != 0 then a / b - 1 else a / b
}

function FloorMod(a: int, b: int): int
  requires b != 0
  ensures b > 0 ==> 0 <= FloorMod(a, b) < b
  ensures b < 0 ==> b < FloorMod(a, b) <= 0
  ensures a == b * FloorDiv(a, b) + FloorMod(a, b)
{
  if b < 0 && a % b != 0 then a % b + b else a % b
}

method qr(a: int, b: int) returns (res: int)
  requires (b != 0)
  ensures (res == ((FloorDiv(a, b) * b) + FloorMod(a, b)))
{
  var q := FloorDiv(a, b);
  var r := FloorMod(a, b);
  q := (q * b);
  q := (q + r);
  r := FloorDiv(r, 1);
  r := FloorMod(r, 7);
  return q;
}
