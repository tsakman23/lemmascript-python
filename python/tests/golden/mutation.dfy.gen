function NormalizeSliceIndex(n: nat, i: int): int
  ensures 0 <= NormalizeSliceIndex(n, i) <= n as int
{
  if i < 0 then
    if n as int + i < 0 then 0 else n as int + i
  else if i > n as int then n as int
  else i
}

function SafeSlice<T>(s: seq<T>, lo: int, hi: int): seq<T>
  ensures |SafeSlice(s, lo, hi)| <= |s|
{
  var lo' := NormalizeSliceIndex(|s|, lo);
  var hi' := NormalizeSliceIndex(|s|, hi);
  if hi' < lo' then [] else s[lo'..hi']
}

method build(n: int, xs: seq<int>) returns (res: seq<int>)
  requires (n >= 0)
  ensures (|res| == ((n + (2 * |xs|)) + 1))
{
  var out: seq<int> := [];
  var i := 0;
  while (i < n)
    invariant (0 <= i)
    invariant ((i <= n) || (i == 0))
    invariant (|out| == i)
  {
    out := (out + [i]);
    i := (i + 1);
  }
  var copy := SafeSlice(xs, 0, |xs|);
  out := (out + copy);
  out := (out + xs);
  out := (out + [0]);
  out := out[(if (n == 0) then 0 else (n - 1)) := 9];
  out := out[(|out| - 1) := (out[(|out| - 1)] + 1)];
  return out;
}
