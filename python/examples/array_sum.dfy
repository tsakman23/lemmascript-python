// Generated by lsc from array_sum.py

function sum_to(xs: seq<int>, n: int): int
  requires (0 <= n)
  requires (n <= |xs|)
  decreases n
{
  if (n == 0) then
    0
  else
    (sum_to(xs, (n - 1)) + xs[(n - 1)])
}

method total(xs: seq<int>) returns (res: int)
  ensures (res == sum_to(xs, |xs|))
{
  var s := 0;
  var i_stop := |xs|;
  var i := 0;
  while (i < i_stop)
    invariant (0 <= i)
    invariant ((i <= i_stop) || (i == 0))
    invariant (s == sum_to(xs, i))
  {
    s := (s + xs[i]);
    i := (i + 1);
  }
  return s;
}
