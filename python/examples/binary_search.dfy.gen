function FloorDiv(a: int, b: int): int
  requires b != 0
{
  if b < 0 && a % b != 0 then a / b - 1 else a / b
}

function FloorMod(a: int, b: int): int
  requires b != 0
  ensures b > 0 ==> 0 <= FloorMod(a, b) < b
  ensures b < 0 ==> b < FloorMod(a, b) <= 0
  ensures a == b * FloorDiv(a, b) + FloorMod(a, b)
{
  if b < 0 && a % b != 0 then a % b + b else a % b
}

function sorted_from(xs: seq<int>, i: nat): bool
  decreases (|xs| - i)
{
  (((i + 1) >= |xs|) || ((xs[i] <= xs[(i + 1)]) && sorted_from(xs, (i + 1))))
}

function is_sorted(xs: seq<int>): bool
{
  sorted_from(xs, 0)
}

method binary_search(xs: seq<int>, target: int) returns (res: int)
  requires is_sorted(xs)
  ensures (-1 <= res)
  ensures (res < |xs|)
  ensures ((res >= 0) ==> (xs[res] == target))
  ensures ((res == -1) ==> forall k: int :: ((0 <= k) ==> (k < |xs|) ==> (xs[k] != target)))
{
  var lo := 0;
  var hi := (|xs| - 1);
  while (lo <= hi)
    invariant (0 <= lo)
    invariant (lo <= |xs|)
    invariant (-1 <= hi)
    invariant (hi < |xs|)
    invariant forall k: int :: ((0 <= k) ==> (k < lo) ==> (xs[k] != target))
    invariant forall k: int :: ((hi < k) ==> (k < |xs|) ==> (xs[k] != target))
    decreases ((hi - lo) + 1)
  {
    var mid := FloorDiv((lo + hi), 2);
    if (xs[mid] == target) {
      return mid;
    } else if (xs[mid] < target) {
      lo := (mid + 1);
    } else {
      hi := (mid - 1);
    }
  }
  return -1;
}
